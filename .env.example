# --- Groq (free LLM) ----------------------------------------
# Get a free key at console.groq.com (no credit card needed)
GROQ_API_KEY=gsk_...

# --- OnlyTrust Agent API Keys --------------------------------
# Each demo agent has its own API key from OnlyTrust.
# Get these from the agent's Developer view in the dashboard.
ONLYTRUST_TRANSLATE_API_KEY=
ONLYTRUST_SUMMARIZE_API_KEY=
ONLYTRUST_ASK_API_KEY=

# --- OnlyTrust API -------------------------------------------
ONLYTRUST_API_URL=https://app.onlytrust.ai

# --- Webhook Security ----------------------------------------
WEBHOOK_SECRET=

# --- Test USDC Drip (for demo page) --------------------------
# Private key of a wallet pre-funded with Base Sepolia test USDC.
# This wallet sends small amounts to demo users who need test tokens.
# ONLY for testnet. Never use a mainnet wallet here.
DRIP_WALLET_PRIVATE_KEY=
DRIP_USDC_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e
DRIP_RPC_URL=https://sepolia.base.org
DRIP_AMOUNT=50000
